# =============================================================
# 自建 Supabase 环境变量模板（docker-compose 用）
# 复制为 .env 后填写，所有生成值请用强随机字符串
# =============================================================

# ---------- Postgres 数据库 ----------
POSTGRES_PASSWORD=your-super-strong-db-password
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# ---------- JWT 密钥（Auth 签发令牌用，务必随机且保密） ----------
# 生成方式：openssl rand -base64 64
JWT_SECRET=your-jwt-secret-at-least-32-chars

# ---------- API 密钥（前端连接用） ----------
# ANON_KEY 是 JWT，payload 需包含 role: anon
# SERVICE_ROLE_KEY 是 JWT，payload 需包含 role: service_role
# 可用 Supabase 官方脚本生成：https://supabase.com/docs/guides/self-hosting/docker
ANON_KEY=your-anon-key-jwt
SERVICE_ROLE_KEY=your-service-role-key-jwt

# ---------- 站点访问地址 ----------
# 公网 HTTPS 域名（前端 .env 和边缘函数都要用这个）
SITE_URL=https://your-domain.com
API_EXTERNAL_URL=https://your-domain.com

# ---------- 数据库连接串（可选，供 Studio 使用） ----------
# DATABASE_URL=postgresql://postgres:your-password@db:5432/postgres

# ---------- 邮件（可选，注册/找回密码用） ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# SMTP_ADMIN_EMAIL=admin@your-domain.com